<?xml version="1.0" encoding="utf-8"?>
<!--
  Satellite mark: central hub (ring + aperture), two diagonal solar panels and a
  dish. Drawn in a 24-unit space and scaled/centered into the 108 adaptive-icon
  canvas, staying within the central safe zone so the launcher mask never clips it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="3"
        android:scaleY="3"
        android:translateX="18"
        android:translateY="18">

        <!-- Hub ring (aperture punched out via even-odd) -->
        <path
            android:fillColor="#FFFFFF"
            android:fillType="evenOdd"
            android:pathData="M12,9.3 a2.7,2.7 0 1,0 0,5.4 a2.7,2.7 0 1,0 0,-5.4 Z M12,10.5 a1.5,1.5 0 1,0 0,3 a1.5,1.5 0 1,0 0,-3 Z" />
        <!-- Hub centre dot -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M12,11.3 a0.7,0.7 0 1,0 0,1.4 a0.7,0.7 0 1,0 0,-1.4 Z" />

        <!-- Solar panel + arm (down-right) -->
        <group android:rotation="45" android:pivotX="12" android:pivotY="12">
            <path android:fillColor="#FFFFFF" android:pathData="M14.6,11.5 H17.0 V12.5 H14.6 Z" />
            <path android:fillColor="#FFFFFF" android:pathData="M17.0,9.3 H18.8 V14.7 H17.0 Z" />
            <path android:fillColor="#FFFFFF" android:pathData="M19.1,9.3 H20.9 V14.7 H19.1 Z" />
            <path android:fillColor="#FFFFFF" android:pathData="M21.2,9.3 H23.0 V14.7 H21.2 Z" />
        </group>

        <!-- Solar panel + arm (up-left) -->
        <group android:rotation="225" android:pivotX="12" android:pivotY="12">
            <path android:fillColor="#FFFFFF" android:pathData="M14.6,11.5 H17.0 V12.5 H14.6 Z" />
            <path android:fillColor="#FFFFFF" android:pathData="M17.0,9.3 H18.8 V14.7 H17.0 Z" />
            <path android:fillColor="#FFFFFF" android:pathData="M19.1,9.3 H20.9 V14.7 H19.1 Z" />
            <path android:fillColor="#FFFFFF" android:pathData="M21.2,9.3 H23.0 V14.7 H21.2 Z" />
        </group>

        <!-- Dish antenna (up-right) -->
        <group android:rotation="315" android:pivotX="12" android:pivotY="12">
            <path android:fillColor="#FFFFFF" android:pathData="M14.4,11.7 H16.0 V12.3 H14.4 Z" />
            <path android:fillColor="#FFFFFF" android:pathData="M17.6,10.3 a1.7,1.7 0 1,0 0,3.4 a1.7,1.7 0 1,0 0,-3.4 Z" />
        </group>
    </group>
</vector>
