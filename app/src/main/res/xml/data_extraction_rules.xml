<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- hyprspace.json contains the node private key and must never be backed up. -->
        <exclude domain="file" path="hyprspace.json" />
    </cloud-backup>
    <device-transfer>
        <!-- Do not clone the node identity during device-to-device transfer. -->
        <exclude domain="file" path="hyprspace.json" />
    </device-transfer>
</data-extraction-rules>
